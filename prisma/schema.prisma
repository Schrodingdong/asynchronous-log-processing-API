generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ProcessingJob {
  id Int @id @default(autoincrement())
  status String
  statistics Json
  logPath String
  errors LogError[]
  owner User @relation(fields: [ownerId], references: [id])
  ownerId Int
}

model LogError {
  id Int @id @default(autoincrement())
  message String
  timestamp DateTime
  job ProcessingJob @relation(fields: [jobId], references: [id])
  jobId Int
}

model User {
  id Int @id @default(autoincrement())
  username String
  password String
  jobs ProcessingJob[]
}
